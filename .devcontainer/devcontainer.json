{
  "name": "Private Mansion Viewer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Private Mansion Gallery",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "npm run dev",
  "remoteEnv": {
    "NODE_ENV": "development",
    "PORT": "3000",
    "DATA_DIR": "/workspaces/Private-mansion/data",
    "STORAGE_MODE": "local",
    "APP_SECRET": "private-mansion-codespaces-access-key"
  }
}
